# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Variables starting with NEXT_PUBLIC_ are sent to the browser; everything else stays on the server.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_HOUSEHOLD_ID=h1

# Claude: hazard detection, weekly summaries, clinician report
ANTHROPIC_API_KEY=

# World Labs Marble: fix previews
WORLD_LABS_API_KEY=

# Twilio: caregiver SMS and phone call alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CAREGIVER_PHONE_NUMBER=
BACKUP_PHONE_NUMBER=
TWILIO_DRY_RUN=1                # 1 = log SMS and calls instead of sending
PUBLIC_BASE_URL=http://localhost:3000   # used in SMS acknowledge links; must be reachable from the caregiver's phone

# Responder (docs/cues.md)
ESCALATION_PROFILE=demo         # demo (fast timers) | real
CUE_GRACE_MIN=                  # 0 to 15: minutes after getting up before any night cue; empty = profile default (demo 15 s, real 5 min)
MORNING_SUMMARY_SMS=0           # 1 = text last night to the primary contact when quiet hours end
ROKU_HOST=                      # empty = Roku calls are logged, not sent

# Vapi voice agents (docs/vapi.md). Empty = off: plain Twilio calls and the browser voice are used instead.
VAPI_API_KEY=                   # server only: places calls to the family
VAPI_PHONE_NUMBER_ID=           # a number imported into Vapi (free Vapi numbers cannot call out)
VAPI_DRY_RUN=0                  # 1 = never place Vapi calls
VAPI_FAMILY_ASSISTANT_ID=       # optional: use an assistant made in the Vapi dashboard instead of the one in code
VAPI_FAMILY_VOICE_ID=           # optional: a Vapi voice id; default Elliot
VAPI_MODEL=                     # optional: default claude-haiku-5-5
NEXT_PUBLIC_VAPI_PUBLIC_KEY=    # the PUBLIC key only: the companion voice on the TV page
NEXT_PUBLIC_VAPI_COMPANION=0    # 1 = turn the companion voice on (opt-in)
NEXT_PUBLIC_VAPI_COMPANION_VOICE_ID=   # optional: default Zoe ("calm, soothing")

# Monitor (npm run dev:monitor)
MONITOR_PORT=8787
MONITOR_DEBUG=1                 # 1 = POST /debug/emit is on (default off when NODE_ENV=production)
MONITOR_CORS_ORIGIN=*           # set to the web origin for anything beyond local dev
NEAREST_ROOM=0                  # 1 = strongest-listener fallback room estimate; leave 0 while the classifier runs
NEXT_PUBLIC_MONITOR_URL=http://localhost:8787
NEXT_PUBLIC_MONITOR_WS=ws://localhost:8787/ws/live
LISTENER_TOKEN=change-me
TAG_SERVICE_UUID=4C414E54-4552-4E00-A000-000000000001
HOUSEHOLD_ID=h1

# Smart bulb (TP-Link Kasa, local network IP)
KASA_BULB_IP=
