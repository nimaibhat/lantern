# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Variables starting with NEXT_PUBLIC_ are sent to the browser; everything else stays on the server.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_HOUSEHOLD_ID=h1

# Claude: hazard detection, weekly summaries, clinician report
ANTHROPIC_API_KEY=

# World Labs Marble: fix previews
WORLD_LABS_API_KEY=

# Twilio: caregiver SMS and phone call alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CAREGIVER_PHONE_NUMBER=
BACKUP_PHONE_NUMBER=

# Monitor (npm run dev:monitor)
MONITOR_PORT=8787
MONITOR_DEBUG=1                 # 1 = POST /debug/emit is on (default off when NODE_ENV=production)
MONITOR_CORS_ORIGIN=*           # set to the web origin for anything beyond local dev
NEAREST_ROOM=0                  # 1 = strongest-listener fallback room estimate; leave 0 while the classifier runs
NEXT_PUBLIC_MONITOR_URL=http://localhost:8787
NEXT_PUBLIC_MONITOR_WS=ws://localhost:8787/ws/live
LISTENER_TOKEN=change-me
TAG_SERVICE_UUID=4C414E54-4552-4E00-A000-000000000001
HOUSEHOLD_ID=h1

# Smart bulb (TP-Link Kasa, local network IP)
KASA_BULB_IP=
