{
  "name": "lantern",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https --experimental-https-key certificates/localhost-key.pem --experimental-https-cert certificates/localhost.pem --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "dev:web": "next dev",
    "dev:monitor": "tsx watch monitor/main.ts",
    "dev:agent": "py -u listener/agent.py",
    "dev:mock-rssi": "tsx tools/mock-rssi.ts",
    "dev:mock-walk": "tsx tools/mock-walk.ts",
    "check-env": "tsx tools/check-env.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.monitor.json",
    "test": "tsx --test \"lib/**/*.test.ts\" \"monitor/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@sparkjsdev/spark": "^2.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "@vapi-ai/web": "^3.0.1",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
