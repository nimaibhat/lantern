# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# local https certificates
certificates/

# Windows reserved name created by a bad redirect
nul

# Next.js build output
.next/
/out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# env files hold secrets; only the template is committed
.env
.env.local
.env.*
!.env.example

# deployment
.vercel/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# testing
coverage/

# OS files
.DS_Store
Thumbs.db

# editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# misc
*.pem

# large source media at the repo root (the web copy lives in public/); anchored so app/api/patient/media is kept
/media/

# Headless browser profiles from local screenshot scripts
*-profile/

# Editor-local MCP config (each person connects their own)
.cursor/

# Python bytecode
__pycache__/

# Per-laptop listener config (created by listener/pair.py)
.lantern-device.json

# Generated by xcodegen (ios/project.yml)
ios/*.xcodeproj/
ios/build/
xcuserdata/

# Personal Claude Code settings (each person keeps their own)
.claude/settings.local.json
